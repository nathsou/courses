/// The RV32I core: the 40 instructions of the RISC-V base set, two cycles each, one to fetch and one to execute.
/// It has no memory of its own: it is handed the instruction at `pc_out` and the word that a load asks for. The ALU
/// is `alu` (alu.weft); the register file is `reg_file` (regfile.weft), 32 registers of flip-flops, or, with
/// `REGISTERS_IN_BRAM`, a memory in block RAM, read while the instruction is being fetched.
module rv32i<REGISTERS_IN_BRAM: bool = false>(
    in  clk: clock,
    in  instruction: uint<32>,
    in  memory_value: uint<32>,
    out pc_out: uint<32>,
    out target_misaligned: bool,
    out executing: bool,
    out memory_address: uint<32>,
    out memory_write: bool,
    out memory_read: bool,
    out memory_width: uint<2>,
    out memory_data: uint<32>,
    out trap_code: uint<2>,
) {
    reg pc: uint<32> = 0;
    reg ir: uint<32> = 0;
    reg execute: bool = false;

    let opcode = ir[6:0];
    let f3 = ir[14:12];
    let f7 = ir[31:25];
    let rd_address = ir[11:7];

    // The register file.
    wire rs1_value: uint<32>;
    wire rs2_value: uint<32>;
    if REGISTERS_IN_BRAM {
        // A block RAM answers a cycle after it gets an address. The core has a cycle to spare: while it fetches,
        // the instruction word is arriving, so the registers are read from that word, and are ready to execute.
        mem x: [uint<32>; 32] init [0; 32];
        reg rs1_read: uint<32> = 0;
        reg rs2_read: uint<32> = 0;
        rs1_read := x[instruction[19:15]];
        rs2_read := x[instruction[24:20]];
        if rd_write && rd_address != 0 {
            x[rd_address] := rd_value;
        }
        rs1_value = rs1_read;
        rs2_value = rs2_read;
    } else {
        inst registers = reg_file(
            clk: clk,
            rs1_address: ir[19:15],
            rs2_address: ir[24:20],
            rd_address: rd_address,
            rd_write: rd_write,
            rd_value: rd_value,
        );
        rs1_value = registers.rs1_value;
        rs2_value = registers.rs2_value;
    }

    // The immediates, sign-extended from bit 31 of the instruction.
    let sign20: uint<20> = if ir[31] { 0xfffff } else { 0 };
    let sign19: uint<19> = if ir[31] { 0x7ffff } else { 0 };
    let sign11: uint<11> = if ir[31] { 0x7ff } else { 0 };
    let imm_i = concat(sign20, ir[31:20]);
    let imm_s = concat(sign20, ir[31:25], ir[11:7]);
    let imm_b = concat(sign19, ir[31], ir[7], ir[30:25], ir[11:8], false);
    let imm_u = concat(ir[31:12], uint<12>(0));
    let imm_j = concat(sign11, ir[31], ir[19:12], ir[20], ir[30:21], false);

    let is_reg = opcode == 0x33;
    let is_imm = opcode == 0x13;
    let is_load = opcode == 0x03;
    let is_store = opcode == 0x23;
    let is_branch = opcode == 0x63;
    let is_jal = opcode == 0x6f;
    let is_jalr = opcode == 0x67;

    let b: uint<32> = if is_reg { rs2_value } else { imm_i };
    let result = alu(rs1_value: rs1_value, b: b, f3: f3, is_reg: is_reg, ir30: ir[30]);

    let branch_less = if rs1_value[31] != rs2_value[31] { rs1_value[31] } else { rs1_value < rs2_value };
    let taken: bool = match f3 {
        0 => rs1_value == rs2_value,
        1 => rs1_value != rs2_value,
        4 => branch_less,
        5 => !branch_less,
        6 => rs1_value < rs2_value,
        7 => rs1_value >= rs2_value,
        _ => false,
    };
    let sign_byte: uint<24> = if memory_value[7] && !f3[2] { 0xffffff } else { 0 };
    let sign_half: uint<16> = if memory_value[15] && !f3[2] { 0xffff } else { 0 };
    let loaded: uint<32> = match f3[1:0] {
        0 => concat(sign_byte, memory_value[7:0]),
        1 => concat(sign_half, memory_value[15:0]),
        _ => memory_value,
    };

    // Which instructions are legal: anything else traps.
    let valid_alu = if is_reg {
        f7 == 0 || (f7 == 0x20 && (f3 == 0 || f3 == 5))
    } else {
        (f3 != 1 && f3 != 5) || (f3 == 1 && f7 == 0) || (f3 == 5 && (f7 == 0 || f7 == 0x20))
    };
    let valid: bool = match opcode {
        0x37 | 0x17 | 0x6f => true,
        0x67 => f3 == 0,
        0x63 => f3 == 0 || f3 == 1 || f3 >= 4,
        0x03 => f3 == 0 || f3 == 1 || f3 == 2 || f3 == 4 || f3 == 5,
        0x23 => f3 <= 2,
        0x13 | 0x33 => valid_alu,
        0x0f => f3 == 0 || f3 == 1,
        0x73 => ir == 0x00000073 || ir == 0x00100073,
        _ => false,
    };
    let trap: uint<2> = if !valid { 1 } else if ir == 0x00000073 { 2 } else if ir == 0x00100073 { 3 } else { 0 };

    let next_pc: uint<32> = if is_jal {
        pc +% imm_j
    } else if is_jalr {
        (rs1_value +% imm_i) & 0xfffffffe
    } else if is_branch && taken {
        pc +% imm_b
    } else {
        pc +% 4
    };
    if !execute { ir := instruction; }
    if execute && trap == 0 { pc := next_pc; }
    execute := !execute;

    let rd_write = execute && trap == 0 && (is_reg || is_imm || is_load || is_jal || is_jalr || opcode == 0x37 || opcode == 0x17);
    let rd_value: uint<32> = match opcode {
        0x03 => loaded,
        0x37 => imm_u,
        0x17 => pc +% imm_u,
        0x6f | 0x67 => pc +% 4,
        _ => result,
    };

    pc_out = pc;
    target_misaligned = next_pc[1];
    executing = execute;
    memory_address = rs1_value +% (if is_store { imm_s } else { imm_i });
    memory_write = execute && is_store && valid;
    memory_read = execute && is_load && valid;
    memory_width = f3[1:0];
    memory_data = rs2_value;
    trap_code = if execute { trap } else { 0 };
}
